#!/usr/bin/bash
exec >> /var/log/setdns.log 2>&1
echo "setdns called: $(date) args: $*"

user=$(python3 -c "import yaml; print(yaml.safe_load(open('/etc/secrets.yml'))['zoneedit_user'])")
token=$(python3 -c "import yaml; print(yaml.safe_load(open('/etc/secrets.yml'))['zoneedit_token'])")
host=$(hostname).critchley.biz

{ [ "$1" == start ] || [ $# -eq 0 ]; } || exit 0

# Check if A record already matches our current IP
current_ip=$(curl -sf https://checkip.amazonaws.com || curl -sf https://api.ipify.org)
dns_ip=$(host -t A "$host" 2>/dev/null | awk '/has address/{print $NF}' | tail -1)

if [ "$current_ip" = "$dns_ip" ]; then
    echo "DNS already correct ($host -> $current_ip), skipping update"
    exit 0
fi

echo "Updating DNS: $host -> $current_ip (was: ${dns_ip:-unset})"
curl -v "https://$user:$token@dynamic.zoneedit.com/auth/dynamic.html?host=$host"
